{
  "version": "1.1",
  "slug": "notification-view",
  "mode": "interactive",
  "role": "admin",
  "title": {
    "fr": "Consulter ses notifications",
    "en": "View your notifications",
    "nl": "Uw meldingen bekijken",
    "de": "Ihre Benachrichtigungen ansehen"
  },
  "locales": [
    "fr",
    "en",
    "nl",
    "de"
  ],
  "defaultLocale": "fr",
  "layouts": [
    "desktop",
    "mobile"
  ],
  "defaultLayout": "desktop",
  "cursor": {
    "pre_action_ms": 200,
    "action_ms": 300,
    "post_action_ms": 150,
    "travel_speed_px_per_ms": 1.5
  },
  "defaultTemplate": "overlay",
  "steps": [
    {
      "id": "step-1",
      "index": 1,
      "action": "click",
      "interactive": true,
      "screenshotWhen": "after",
      "waitAfter": 500,
      "title": {
        "fr": "Ouvrir les notifications",
        "en": "Open notifications",
        "nl": "De meldingen openen",
        "de": "Die Benachrichtigungen öffnen"
      },
      "text": {
        "fr": "Cliquez sur la cloche dans la barre latérale pour ouvrir le panneau des notifications. La notification d'invitation à rejoindre la communauté y apparaît, avec le nom de la communauté et le moment de réception.",
        "en": "Click the bell in the sidebar to open the notifications panel. The invitation to join the community appears here, with the community name and when it was received.",
        "nl": "Klik op de bel in de zijbalk om het meldingenpaneel te openen. De melding van de uitnodiging om lid te worden van de gemeenschap verschijnt daar, met de naam van de gemeenschap en het tijdstip van ontvangst.",
        "de": "Klicken Sie auf die Glocke in der Seitenleiste, um den Benachrichtigungsbereich zu öffnen. Die Benachrichtigung über die Einladung, der Gemeinschaft beizutreten, erscheint dort mit dem Namen der Gemeinschaft und dem Zeitpunkt des Empfangs."
      },
      "subtitle": {
        "fr": "Cloche de notification",
        "en": "Notification bell",
        "nl": "Meldingsbel",
        "de": "Benachrichtigungsglocke"
      },
