    {
      "id": "step-3",
      "index": 3,
      "action": "scroll",
      "interactive": true,
      "screenshotWhen": "after",
      "waitAfter": 0,
      "title": {
        "fr": "La pièce est signée",
        "en": "The document is signed",
        "nl": "Het document is ondertekend",
        "de": "Die Unterlage ist unterschrieben"
      },
      "text": {
        "fr": "Quand le participant a signé, la pièce affiche **« Signé électroniquement »**. Le PDF signé et scellé est devenu sa version finale : il n'y a rien à téléverser.",
        "en": "Once the participant has signed, the document shows **\"Signed electronically\"**. The signed and sealed PDF has become its final version: there is nothing to upload.",
        "nl": "Zodra de deelnemer heeft ondertekend, toont het document **“Elektronisch ondertekend”**. De ondertekende en verzegelde pdf is de definitieve versie geworden: u hoeft niets te uploaden.",
        "de": "Sobald der Teilnehmer unterschrieben hat, zeigt die Unterlage **„Elektronisch unterschrieben“**. Das unterschriebene und versiegelte PDF ist ihre endgültige Version geworden: Sie müssen nichts hochladen."
      },
      "subtitle": {
        "fr": "Signature électronique",
        "en": "Electronic signature",
        "nl": "Elektronische handtekening",
        "de": "Elektronische Unterschrift"
      },
