    {
      "id": "step-4",
      "index": 4,
      "action": "wait-for",
      "interactive": false,
      "screenshotWhen": "after",
      "waitAfter": 0,
      "title": {
        "fr": "La preuve de la signature",
        "en": "The proof of the signature",
        "nl": "Het bewijs van de handtekening",
        "de": "Der Nachweis der Unterschrift"
      },
      "text": {
        "fr": "**« Preuve »** télécharge le rapport de preuve : qui a signé, quand, pour le compte de qui, et l'empreinte du document. Gardez-le avec le dossier, il atteste la signature.",
        "en": "**\"Evidence\"** downloads the evidence report: who signed, when, on whose behalf, and the document's fingerprint. Keep it with the dossier: it attests the signature.",
        "nl": "**“Bewijs”** downloadt het bewijsrapport: wie heeft ondertekend, wanneer, voor wiens rekening, en de vingerafdruk van het document. Bewaar het bij het dossier: het staaft de handtekening.",
        "de": "**„Nachweis“** lädt den Nachweisbericht herunter: wer unterschrieben hat, wann, in wessen Auftrag, und den Fingerabdruck des Dokuments. Bewahren Sie ihn beim Dossier auf: Er belegt die Unterschrift."
      },
      "subtitle": {
        "fr": "Signature électronique",
        "en": "Electronic signature",
        "nl": "Elektronische handtekening",
        "de": "Elektronische Unterschrift"
      },
