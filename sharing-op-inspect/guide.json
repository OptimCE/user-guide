      "interactive": true,
      "screenshotWhen": "before",
      "waitAfter": 0,
      "title": {
        "fr": "Ouvrir une opération",
        "en": "Open an operation",
        "nl": "Een operatie openen",
        "de": "Eine Operation öffnen"
      },
      "text": {
        "fr": "Cliquez sur la première ligne du tableau pour afficher la fiche détaillée de l'opération de partage et explorer sa configuration.",
        "en": "Click the first row of the table to open the sharing operation's detail page and inspect its configuration.",
        "nl": "Klik op de eerste rij van de tabel om de detailfiche van de deeloperatie weer te geven en de configuratie ervan te verkennen.",
        "de": "Klicken Sie auf die erste Zeile der Tabelle, um die Detailseite der Teilungsoperation anzuzeigen und ihre Konfiguration zu erkunden."
      },
      "subtitle": {
        "fr": "Liste des opérations",
        "en": "Operations list",
        "nl": "Lijst van de operaties",
        "de": "Liste der Operationen"
      },
