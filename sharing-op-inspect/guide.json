  "title": {
    "fr": "Inspecter une opération de partage",
    "en": "Inspect a sharing operation",
    "nl": "Een deeloperatie inspecteren",
    "de": "Teilungsoperation im Detail ansehen"
  },
  "locales": [
    "fr",
    "en",
    "nl",
    "de"
  ],
  "defaultLocale": "fr",
  "layouts": [
    "desktop",
    "mobile"
