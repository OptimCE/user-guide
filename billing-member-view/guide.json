                      "x": 8,
                      "y": 436,
                      "width": 284,
                      "height": 36
                    },
                    "selector": "[data-testid=\"navbar__menu--community\"] a[href=\"/billing\"]"
                  }
                }
              }
            ],
            "content": {
              "title": "Ouvrir mes factures",
              "text": "Touchez l'icône du menu pour ouvrir le tiroir de navigation, puis dans la section « Communauté » touchez « Facturation ».",
              "subtitle": "Navigation"
            }
