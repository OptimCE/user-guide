{
  "version": "1.1",
  "slug": "billing-member-view",
  "mode": "interactive",
  "role": "admin",
  "title": {
    "fr": "Consulter sa facture",
    "en": "View your own bill"
  },
  "locales": [
    "fr",
    "en"
  ],
  "defaultLocale": "fr",
  "layouts": [
    "desktop",
    "mobile"
  ],
  "defaultLayout": "desktop",
  "cursor": {
    "pre_action_ms": 200,
    "action_ms": 300,
    "post_action_ms": 150,
    "travel_speed_px_per_ms": 1.5
  },
  "defaultTemplate": "overlay",
  "steps": [
    {
      "id": "step-1",
      "index": 1,
      "action": "click",
      "interactive": true,
      "screenshotWhen": "before",
      "waitAfter": 1000,
      "title": {
        "fr": "Ouvrir mes factures",
        "en": "Open my invoices"
      },
      "text": {
        "fr": "Dans la section « Communauté » de la barre latérale, cliquez sur « Facturation » pour accéder à vos factures. En tant que membre, vous ne voyez que les vôtres.",
        "en": "In the sidebar's \"Community\" section, click \"Billing\" to reach your invoices. As a member you only ever see your own."
      },
      "subtitle": {
        "fr": "Navigation",
        "en": "Navigation"
      },
      "captures": {
        "fr": {
          "desktop": {
            "frames": [
              {
                "screenshot": "../assets/billing-member-view/fr/desktop/step-14.png",
                "captureSize": {
                  "width": 1440,
                  "height": 900
                },
                "cursor": {
                  "kind": "click",
                  "target": {
                    "bbox": {
                      "x": 8,
                      "y": 436,
                      "width": 243,
                      "height": 36
                    },
                    "selector": "[data-testid=\"navbar__menu--community\"] a[href=\"/billing\"]"
                  }
                }
              }
            ]
          },
          "mobile": {
            "frames": [
              {
                "screenshot": "../assets/billing-member-view/fr/mobile/step-17.png",
                "captureSize": {
                  "width": 390,
