{
  "version": "1.1",
  "slug": "audit-log-inspect",
  "mode": "interactive",
  "role": "admin",
  "title": {
    "fr": "Consulter le journal d'audit",
    "en": "Consult the audit log"
  },
  "locales": [
    "fr",
    "en"
  ],
  "defaultLocale": "fr",
  "layouts": [
    "desktop",
    "mobile"
  ],
