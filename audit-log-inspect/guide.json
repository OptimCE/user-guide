      "index": 1,
      "action": "click",
      "interactive": true,
      "screenshotWhen": "before",
      "waitAfter": 1000,
      "title": {
        "fr": "Ouvrir le journal d'audit",
        "en": "Open the audit log"
      },
      "text": {
        "fr": "Dans la section « Gestion » de la barre latérale, cliquez sur « Journal d'audit » pour consulter l'historique des actions effectuées sur votre communauté.",
        "en": "In the sidebar's \"Management\" section, click \"Audit log\" to review the history of actions performed on your community."
      },
      "subtitle": {
        "fr": "Navigation",
        "en": "Navigation"
      },
