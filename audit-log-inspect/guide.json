      "interactive": false,
      "screenshotWhen": "after",
      "waitAfter": 0,
      "title": {
        "fr": "Le journal d'audit",
        "en": "The audit log"
      },
      "text": {
        "fr": "Chaque ligne retrace une action : la date, le type d'action, l'entité concernée, l'auteur et la source. La modification que vous venez d'effectuer apparaît en tête de liste.",
        "en": "Each row records one action: the timestamp, the action type, the affected entity, who did it, and the source. The change you just made appears at the top of the list."
      },
      "subtitle": {
        "fr": "Traçabilité",
        "en": "Traceability"
      },
      "captures": {
        "fr": {
          "desktop": {
            "frames": [
              {
                "screenshot": "../assets/audit-log-inspect/fr/desktop/step-27.png",
                "captureSize": {
